{
  "name": "tst2",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "build:css": "npx @tailwindcss/cli -i ./styles/input.css -o ./public/stylesheets/style.css",
    "watch:css": "npx @tailwindcss/cli -i ./styles/input.css -o ./public/stylesheets/style.css --watch",
    "watch:server": "nodemon ./bin/www",
    "watch:python": "cd python_service && venv\\Scripts\\python -m uvicorn main:app --reload --port 5200",
    "dev": "concurrently \"npm run watch:css\" \"npm run watch:server\" \"npm run watch:python\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.5.0",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "ejs-mate": "^4.0.0",
    "express": "^4.22.1",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "puppeteer": "^24.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11",
    "tailwindcss": "^4.1.18"
  }
}
