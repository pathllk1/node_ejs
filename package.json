{
  "name": "tst2",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "build": "npm run build:css && npm run generate:prisma-all",
    "build:css": "npx @tailwindcss/cli -i ./styles/input.css -o ./public/stylesheets/style.css",
    "generate:prisma-main": "npx prisma generate --schema=./prisma/schema.prisma",
    "generate:prisma-mongo": "npx prisma generate --schema=./prisma/mongo-schema.prisma",
    "generate:prisma-all": "npm run generate:prisma-main && npm run generate:prisma-mongo",
    "watch:css": "npx @tailwindcss/cli -i ./styles/input.css -o ./public/stylesheets/style.css --watch",
    "watch:server": "nodemon ./bin/www --ignore venv --ignore node_modules",
    "dev": "concurrently \"npm run watch:css\" \"npm run watch:server\"",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@prisma/client": "^6.19.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "ejs-mate": "^4.0.0",
    "express": "^4.22.1",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^9.0.3",
    "libsql": "^0.5.22",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pdfmake": "^0.3.2",
    "prisma": "^6.19.1",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11",
    "tailwindcss": "^4.1.18"
  }
}
