generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = "file:../config/app.db"
}

model bill_sequences {
  id             Int    @id @default(autoincrement())
  firm_id        Int
  financial_year String
  last_sequence  Int    @default(0)
  created_at     String @default("CURRENT_TIMESTAMP")
  updated_at     String @default("CURRENT_TIMESTAMP")
  firms          firms  @relation(fields: [firm_id], references: [id], onUpdate: NoAction)

  @@unique([firm_id, financial_year], map: "sqlite_autoindex_bill_sequences_1")
  @@index([firm_id], map: "idx_bill_sequences_firm_id")
  @@index([firm_id, financial_year], map: "idx_bill_sequences_firm_year")
}

model bills {
  id                   Int         @id @default(autoincrement())
  bno                  String      @unique(map: "idx_bills_bno_unique")
  bdate                String
  supply               String
  addr                 String?
  gstin                String?     @default("UNREGISTERED")
  state                String?
  pin                  Int?
  gtot                 Float
  disc                 Float?
  cgst                 Float?
  usern                String
  sgst                 Float?
  firm                 String
  igst                 Float?
  rof                  Float?
  ntot                 Float
  btype                String      @default("SALES")
  order_no             String?
  order_date           String?
  dispatch_through     String?
  docket_no            String?
  vehicle_no           String?
  consignee_name       String?
  consignee_gstin      String?
  consignee_address    String?
  consignee_state      String?
  consignee_pin        String?
  reason_for_note      String?
  original_bill_no     String?
  original_bill_date   String?
  narration            String?
  status               String?     @default("ACTIVE")
  cancellation_reason  String?
  cancelled_at         String?
  cancelled_by         Int?
  attachment_url       String?
  attachment_file_id   String?
  party_id             Int?
  oth_chg_json         String?
  gst_selection_json   String?
  reverse_charge       Int?        @default(0)
  created_at           String
  updated_at           String
  firm_id              Int?
  state_code           Int?
  consignee_state_code Int?
  users                users?      @relation(fields: [cancelled_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parties              parties?    @relation(fields: [party_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  firms                firms?      @relation(fields: [firm_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ledger               ledger[]
  stock_reg            stock_reg[]

  @@index([party_id], map: "idx_bills_party_id")
  @@index([bno], map: "idx_bills_bno")
  @@index([firm_id], map: "idx_bills_firm_id")
}

model firm_settings {
  id            Int     @id @default(autoincrement())
  firm_id       Int
  setting_key   String
  setting_value String
  description   String?
  created_at    String
  updated_at    String
  firms         firms   @relation(fields: [firm_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([firm_id, setting_key], map: "sqlite_autoindex_firm_settings_1")
}

model firms {
  id                  Int              @id @default(autoincrement())
  name                String           @unique(map: "sqlite_autoindex_firms_1")
  address             String?
  contact_info        String?
  created_at          String
  updated_at          String
  legal_name          String?
  city                String?
  state               String?
  country             String?          @default("India")
  pincode             String?
  phone_number        String?
  secondary_phone     String?
  email               String?
  website             String?
  business_type       String?
  industry_type       String?
  establishment_year  Int?
  employee_count      Int?
  registration_number String?
  registration_date   String?
  cin_number          String?
  pan_number          String?
  gst_number          String?
  tax_id              String?
  vat_number          String?
  bank_account_number String?
  bank_name           String?
  bank_branch         String?
  ifsc_code           String?
  payment_terms       String?          @default("Net 30")
  status              String?          @default("ACTIVE")
  license_numbers     String?
  insurance_details   String?
  currency            String?          @default("INR")
  timezone            String?          @default("Asia/Kolkata")
  fiscal_year_start   Int?             @default(4)
  invoice_prefix      String?          @default("INV")
  quote_prefix        String?          @default("QT")
  po_prefix           String?          @default("PO")
  logo_url            String?
  invoice_template    String?          @default("standard")
  enable_e_invoice    Int?             @default(0)
  bill_sequences      bill_sequences[]
  bills               bills[]
  firm_settings       firm_settings[]
  ledger              ledger[]
  parties             parties[]
  stock_reg           stock_reg[]
  stocks              stocks[]
  users               users[]
}

model ledger {
  id               Int      @id @default(autoincrement())
  voucher_id       Int
  voucher_type     String
  voucher_no       String
  account_head     String
  account_type     String
  debit_amount     Float?   @default(0)
  credit_amount    Float?   @default(0)
  narration        String?
  bill_id          Int?
  party_id         Int?
  tax_type         String?
  tax_rate         Float?
  transaction_date String
  created_by       String
  firm_id          Int
  created_at       String   @default("datetime('now')")
  updated_at       String   @default("datetime('now')")
  parties          parties? @relation(fields: [party_id], references: [id], onUpdate: NoAction)
  bills            bills?   @relation(fields: [bill_id], references: [id], onUpdate: NoAction)
  firms            firms    @relation(fields: [firm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([transaction_date], map: "idx_ledger_transaction_date")
  @@index([voucher_id, firm_id], map: "idx_ledger_voucher_id_firm")
  @@index([account_head, firm_id], map: "idx_ledger_account_head_firm")
  @@index([firm_id], map: "idx_ledger_firm_id")
}

model parties {
  id                Int          @id @default(autoincrement())
  supply            String
  addr              String?
  gstin             String?      @default("UNREGISTERED")
  state             String?
  state_code        Int?
  pin               Int?
  pan               String?
  contact           String?
  usern             String
  firm              String
  has_multiple_gsts Int?         @default(0)
  created_at        String
  updated_at        String
  firm_id           Int?
  bills             bills[]
  ledger            ledger[]
  firms             firms?       @relation(fields: [firm_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  party_gsts        party_gsts[]

  @@index([gstin], map: "idx_parties_gstin")
  @@index([firm_id], map: "idx_parties_firm_id")
}

model party_gsts {
  id                Int     @id @default(autoincrement())
  party_id          Int
  gst_number        String
  state             String
  state_code        Int
  location_name     String
  address           String
  city              String
  pincode           String
  contact_person    String?
  contact_number    String?
  is_active         Int?    @default(1)
  is_default        Int?    @default(0)
  registration_type String? @default("regular")
  valid_from        String
  valid_to          String?
  last_used_date    String?
  transaction_count Int?    @default(0)
  parties           parties @relation(fields: [party_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model request_logs {
  id         Int     @id @default(autoincrement())
  method     String
  url        String
  ip         String?
  username   String?
  user_agent String?
  timestamp  String  @default("datetime('now')")
}

model settings {
  id            Int     @id @default(autoincrement())
  setting_key   String  @unique(map: "sqlite_autoindex_settings_1")
  setting_value String
  description   String?
  created_at    String
  updated_at    String
}

model stock_reg {
  id             Int     @id @default(autoincrement())
  type           String
  bno            String
  bdate          String
  supply         String
  item           String
  item_narration String?
  pno            String?
  batch          String?
  oem            String?
  hsn            String
  qty            Float
  qtyh           Float
  uom            String
  rate           Float
  grate          Float?
  cgst           Float?
  sgst           Float?
  igst           Float?
  disc           Float?
  discamt        Float?
  total          Float
  mrp            Float?
  expiry_date    String?
  project        String?
  user           String
  firm           String
  stock_id       Int?
  bill_id        Int?
  created_at     String
  updated_at     String
  firm_id        Int?
  bills          bills?  @relation(fields: [bill_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stocks         stocks? @relation(fields: [stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  firms          firms?  @relation(fields: [firm_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([item], map: "idx_stockreg_item")
  @@index([bno], map: "idx_stockreg_bno")
  @@index([firm_id], map: "idx_stockreg_firm_id")
}

model stocks {
  id         Int         @id @default(autoincrement())
  item       String
  pno        String?
  oem        String?
  hsn        String
  qty        Float
  uom        String
  rate       Float
  grate      Float
  total      Float
  mrp        Float?
  batches    String?
  user       String
  created_at String
  updated_at String
  firm_id    Int?
  stock_reg  stock_reg[]
  firms      firms?      @relation(fields: [firm_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([item, firm_id], map: "idx_stocks_item_firm")
  @@index([firm_id], map: "idx_stocks_firm_id")
}

model users {
  id         Int     @id @default(autoincrement())
  fullname   String
  username   String  @unique(map: "sqlite_autoindex_users_1")
  email      String  @unique(map: "sqlite_autoindex_users_2")
  password   String
  firm_id    Int?
  role       Int?
  created_at String
  updated_at String
  bills      bills[]
  firms      firms?  @relation(fields: [firm_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
