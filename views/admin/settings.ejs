<%- layout('layouts/main') -%>

<div class="p-6 max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">System Settings</h1>
    
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <h2 class="text-lg font-semibold text-gray-700 mb-4">GST Configuration</h2>
        
        <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
            <div>
                <h3 class="font-medium text-gray-800">GST Calculation</h3>
                <p class="text-sm text-gray-600 mt-1">Enable or disable GST calculation across the entire inventory system</p>
            </div>
            
            <div class="flex items-center">
                <span id="gstStatusText" class="mr-3 font-medium">Loading...</span>
                <button id="gstToggleBtn" class="relative inline-flex h-6 w-11 items-center rounded-full bg-gray-300 transition-colors focus:outline-none" disabled>
                    <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform"></span>
                </button>
            </div>
        </div>
        
        <div class="mt-4 text-sm text-gray-600">
            <p><strong>Note:</strong> When GST is disabled, all tax calculations will be skipped in bills and invoices. Existing bills will retain their original tax calculations.</p>
        </div>
    </div>
    
        <!-- Firm Management Section -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <h2 class="text-lg font-semibold text-gray-700 mb-4">Firm Management</h2>
        
        <div class="mb-6">
            <h3 class="text-md font-medium text-gray-700 mb-3">Add New Firm</h3>
            <form id="addFirmForm" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="firmName" class="block text-sm font-medium text-gray-700 mb-1">Firm Name *</label>
                        <input type="text" id="firmName" name="name" required 
                               class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    <div>
                        <label for="firmAddress" class="block text-sm font-medium text-gray-700 mb-1">Address</label>
                        <input type="text" id="firmAddress" name="address" 
                               class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                    </div>
                </div>
                <div>
                    <label for="firmContact" class="block text-sm font-medium text-gray-700 mb-1">Contact Information</label>
                    <input type="text" id="firmContact" name="contact_info" 
                           class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                </div>
                <button type="submit" 
                        class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                    Add Firm
                </button>
            </form>
        </div>
        
        <div>
            <h3 class="text-md font-medium text-gray-700 mb-3">Existing Firms</h3>
            <div id="firmsList" class="space-y-2">
                <p class="text-gray-600">Loading firms...</p>
            </div>
        </div>
    </div>
    
    <!-- User-Firm Assignment Section -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-lg font-semibold text-gray-700 mb-4">User-Firm Assignment</h2>
        
        <div class="mb-6">
            <h3 class="text-md font-medium text-gray-700 mb-3">Assign User to Firm</h3>
            <form id="assignUserForm" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="userIdSelect" class="block text-sm font-medium text-gray-700 mb-1">User</label>
                        <select id="userIdSelect" name="userId" required 
                                class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                            <option value="">Select a user</option>
                        </select>
                    </div>
                    <div>
                        <label for="firmIdSelect" class="block text-sm font-medium text-gray-700 mb-1">Firm</label>
                        <select id="firmIdSelect" name="firmId" required 
                                class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                            <option value="">Select a firm</option>
                        </select>
                    </div>
                </div>
                <button type="submit" 
                        class="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2">
                    Assign User to Firm
                </button>
            </form>
        </div>
        
        <div>
            <h3 class="text-md font-medium text-gray-700 mb-3">Users with Firm Assignments</h3>
            <div id="usersWithFirmsList" class="space-y-2">
                <p class="text-gray-600">Loading users...</p>
            </div>
        </div>
    </div>
</div>

<script src="/javascripts/admin/settings.js"></script>