<% layout('layouts/main') -%>
<link rel="stylesheet" href="/stylesheets/ai-style.css">


<div class="flex items-center justify-center min-h-[80vh]">
    <div class="w-full max-w-lg">
        
        <div class="text-center mb-8">
            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">AI Imagination Engine</h1>
            <p class="text-slate-500 mt-2">Powered by Node.js & Python Microservices</p>
        </div>

        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-slate-100 transition-all duration-300 hover:shadow-2xl">
            <div class="p-8">
                <label for="aiInput" class="block text-sm font-semibold text-slate-700 mb-2">
                    Enter your text to analyze
                </label>
                
                <textarea 
                    id="aiInput" 
                    rows="4" 
                    class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 outline-none transition-all duration-200 resize-none text-slate-700 placeholder-slate-400"
                    placeholder="e.g. I have a great imagination and I love coding..."></textarea>

                <button 
                    id="analyzeBtn"
                    type="button"
                    class="w-full mt-6 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg shadow-indigo-500/30 active:scale-95 transition-all duration-200 flex items-center justify-center gap-2 group">
                    
                    <svg class="w-5 h-5 transition-transform group-hover:rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    
                    <span>Analyze Sentiment</span>
                </button>
            </div>
            
            <div id="loader" class="h-1 bg-slate-100 w-full hidden">
                <div class="h-full bg-indigo-500 animate-progress origin-left"></div>
            </div>
        </div>

        <div id="resultCard" class="mt-6 bg-white rounded-xl shadow-lg border border-slate-100 p-6 hidden opacity-0 translate-y-4 transition-all duration-500">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-slate-800">Analysis Result</h3>
                <span id="scoreBadge" class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-slate-100 text-slate-600">
                    --
                </span>
            </div>
            
            <div class="space-y-3">
                <div class="flex justify-between text-sm">
                    <span class="text-slate-500">Sentiment</span>
                    <span id="sentimentResult" class="font-medium text-slate-900">--</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-slate-500">Confidence</span>
                    <span id="confidenceResult" class="font-medium text-slate-900">--</span>
                </div>
            </div>
        </div>

    </div>
</div>

<script defer src="/javascripts/ai-client.js"></script>