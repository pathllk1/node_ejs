<% layout('layouts/main') -%>
<style>
    /* Hide scrollbar for Chrome, Safari and Opera */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    /* Hide scrollbar for IE, Edge and Firefox */
    .no-scrollbar { -ms-overflow-style: none;  scrollbar-width: none; }
    
    .glass-panel {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.5);
    }
</style>

<div class="flex items-center justify-center h-[85vh] p-4">
    <div class="w-full max-w-2xl h-full flex flex-col glass-panel rounded-3xl shadow-2xl overflow-hidden relative">
        
        <div class="px-6 py-4 border-b border-white/50 bg-white/40 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-3 h-3 rounded-full bg-green-500 animate-pulse"></div>
                <h1 class="font-bold text-slate-700 text-lg">Imagination AI</h1>
            </div>
            <span class="text-xs text-slate-500 font-medium px-2 py-1 bg-white/50 rounded-lg">Powered by Node + Python</span>
        </div>

        <div id="chatContainer" class="flex-1 overflow-y-auto p-6 space-y-4 no-scrollbar scroll-smooth">
            
            <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 text-xs font-bold shrink-0">
                    AI
                </div>
                <div class="bg-white p-3 rounded-2xl rounded-tl-none shadow-sm border border-slate-100 max-w-[80%]">
                    <p class="text-sm text-slate-700 leading-relaxed">Hello! I am your imagination engine. What are we building today?</p>
                </div>
            </div>

            </div>

        <div class="p-4 bg-white/60 border-t border-white/50">
            <div class="relative flex items-center gap-2">
                <input 
                    type="text" 
                    id="userMsg" 
                    class="w-full pl-5 pr-12 py-4 rounded-xl bg-white border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 outline-none transition-all shadow-sm text-slate-700 placeholder-slate-400"
                    placeholder="Type your message..."
                    autocomplete="off"
                >
                <button 
                    id="sendBtn"
                    class="absolute right-2 p-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg transition-colors shadow-md">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
                </button>
            </div>
        </div>
        
    </div>
</div>

<script src="/javascripts/chat-client.js"></script>