<% layout('layouts/main') -%>

<div class="container mx-auto p-6">
    <!-- Hero Section -->
    <div class="text-center mb-12">
        <h1 class="text-4xl font-extrabold text-gray-900 mb-4 tracking-tight">
            Secure Express.js Authentication
        </h1>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
            Experience enterprise-grade security with dual-token authentication,
            comprehensive input sanitization, and strict Content Security Policy protection.
        </p>
    </div>

    <!-- Security Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        
        <!-- Dual-Token Authentication Card -->
        <div class="group bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-100 rounded-2xl p-8 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 hover:scale-105">
            <div class="flex items-center justify-center w-16 h-16 bg-blue-500 rounded-full mb-6 group-hover:bg-blue-600 transition-colors duration-300">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Dual-Token Authentication</h3>
            <p class="text-gray-600 leading-relaxed">
                Short-lived access tokens (15 minutes) with automatic refresh using long-lived refresh tokens (7 days)
                for seamless, secure authentication.
            </p>
            <div class="mt-6 flex items-center space-x-4">
                <span class="px-3 py-1 bg-blue-100 text-blue-800 text-sm font-medium rounded-full">15 min</span>
                <span class="px-3 py-1 bg-indigo-100 text-indigo-800 text-sm font-medium rounded-full">7 days</span>
            </div>
        </div>

        <!-- Input Sanitization Card -->
        <div class="group bg-gradient-to-br from-green-50 to-emerald-50 border border-green-100 rounded-2xl p-8 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 hover:scale-105">
            <div class="flex items-center justify-center w-16 h-16 bg-green-500 rounded-full mb-6 group-hover:bg-green-600 transition-colors duration-300">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">XSS Protection</h3>
            <p class="text-gray-600 leading-relaxed">
                Advanced input sanitization using the xss library to strip malicious scripts and prevent
                cross-site scripting attacks.
            </p>
            <div class="mt-6 flex items-center space-x-2">
                <span class="px-3 py-1 bg-green-100 text-green-800 text-sm font-medium rounded-full">Sanitized</span>
                <span class="px-3 py-1 bg-emerald-100 text-emerald-800 text-sm font-medium rounded-full">Safe</span>
            </div>
        </div>

        <!-- CSP Protection Card -->
        <div class="group bg-gradient-to-br from-purple-50 to-pink-50 border border-purple-100 rounded-2xl p-8 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 hover:scale-105">
            <div class="flex items-center justify-center w-16 h-16 bg-purple-500 rounded-full mb-6 group-hover:bg-purple-600 transition-colors duration-300">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Content Security Policy</h3>
            <p class="text-gray-600 leading-relaxed">
                Strict CSP policies blocking inline scripts, external resources, and eval() to prevent
                code injection attacks.
            </p>
            <div class="mt-6 flex items-center space-x-2">
                <span class="px-3 py-1 bg-purple-100 text-purple-800 text-sm font-medium rounded-full">Strict</span>
                <span class="px-3 py-1 bg-pink-100 text-pink-800 text-sm font-medium rounded-full">Secure</span>
            </div>
        </div>
    </div>

    <!-- Feature Highlights -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-16">
        <div class="space-y-6">
            <h2 class="text-3xl font-bold text-gray-900">Enterprise Security Features</h2>
            <div class="space-y-4">
                <% const features = [
                    { icon: "🔒", title: "Password Security", desc: "bcrypt hashing with salt rounds" },
                    { icon: "🛡️", title: "Security Headers", desc: "X-Frame-Options, X-XSS-Protection, CSP" },
                    { icon: "📊", title: "Request Logging", desc: "Comprehensive audit trail for all requests" },
                    { icon: "🔐", title: "Auto Token Refresh", desc: "Seamless authentication without interruption" }
                ]; %>
                
                <% features.forEach(feature => { %>
                    <div class="flex items-start space-x-4 p-4 bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow duration-300 group">
                        <div class="text-2xl group-hover:scale-110 transition-transform duration-300">
                            <%= feature.icon %>
                        </div>
                        <div>
                            <h4 class="font-semibold text-gray-900"><%= feature.title %></h4>
                            <p class="text-gray-600 text-sm"><%= feature.desc %></p>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
        
        <div class="bg-gradient-to-br from-gray-50 to-gray-100 rounded-2xl p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-6">Security Architecture</h3>
            <div class="space-y-4">
                <div class="flex items-center justify-between p-4 bg-white rounded-lg shadow-sm">
                    <span class="font-medium text-gray-700">Layer 1: Input Validation</span>
                    <span class="text-green-500 font-bold">✓ Active</span>
                </div>
                <div class="flex items-center justify-between p-4 bg-white rounded-lg shadow-sm">
                    <span class="font-medium text-gray-700">Layer 2: Authentication</span>
                    <span class="text-green-500 font-bold">✓ Active</span>
                </div>
                <div class="flex items-center justify-between p-4 bg-white rounded-lg shadow-sm">
                    <span class="font-medium text-gray-700">Layer 3: Authorization</span>
                    <span class="text-green-500 font-bold">✓ Active</span>
                </div>
                <div class="flex items-center justify-between p-4 bg-white rounded-lg shadow-sm">
                    <span class="font-medium text-gray-700">Layer 4: Network Security</span>
                    <span class="text-green-500 font-bold">✓ Active</span>
                </div>
                <div class="flex items-center justify-between p-4 bg-white rounded-lg shadow-sm">
                    <span class="font-medium text-gray-700">Layer 5: Browser Security</span>
                    <span class="text-green-500 font-bold">✓ Active</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Call to Action -->
    <div class="text-center">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">Ready to Experience Secure Authentication?</h2>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/users/login" class="bg-gradient-to-r from-blue-600 to-indigo-600 text-white px-8 py-4 rounded-full font-semibold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300 hover:scale-105 group">
                <span class="flex items-center justify-center space-x-2">
                    <svg class="w-5 h-5 group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
                    </svg>
                    <span>Login Now</span>
                </span>
            </a>
            <a href="/users/signup" class="bg-gradient-to-r from-green-600 to-emerald-600 text-white px-8 py-4 rounded-full font-semibold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300 hover:scale-105 group">
                <span class="flex items-center justify-center space-x-2">
                    <svg class="w-5 h-5 group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                    </svg>
                    <span>Create Account</span>
                </span>
            </a>
        </div>
        <p class="text-gray-500 mt-4 text-sm">All data is protected with enterprise-grade security measures</p>
    </div>
</div>

<!-- Micro-animations Script -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Animate cards on scroll
    const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver(function(entries) {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
            }
        });
    }, observerOptions);

    // Add animation classes to cards
    document.querySelectorAll('.group').forEach(card => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';
        card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
        observer.observe(card);
    });
});
</script>
