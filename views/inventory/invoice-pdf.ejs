<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= invoiceTitle %></title>
    <style>
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; }
        body { font-family: system-ui, -apple-system, Segoe UI, Segoe UI Symbol, Roboto, Arial, sans-serif; color: #111827; }

        .page { padding: 10px; }

        .header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
        .header-left { min-width: 0; }
        .header-right { text-align: right; min-width: 210px; }

        .title { font-size: 18px; font-weight: 800; letter-spacing: 0.4px; margin: 0 0 6px 0; }
        .subtitle { font-size: 12px; color: #374151; margin: 0; }

        .seller { margin-top: 10px; }
        .seller .name { font-size: 14px; font-weight: 700; margin: 0; }
        .seller .meta { font-size: 11px; color: #374151; margin: 2px 0 0 0; line-height: 1.35; white-space: pre-line; }

        .invoice-meta { border: 1px solid #E5E7EB; border-radius: 10px; padding: 10px 12px; }
        .invoice-meta .row { display: flex; justify-content: space-between; gap: 10px; font-size: 11px; color: #111827; margin: 4px 0; }
        .invoice-meta .label { color: #6B7280; }
        .invoice-meta .value { font-weight: 600; }

        .divider { height: 1px; background: #E5E7EB; margin: 14px 0; }

        .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
        .box { border: 1px solid #E5E7EB; border-radius: 10px; padding: 10px 12px; }
        .box h3 { margin: 0 0 8px 0; font-size: 12px; font-weight: 700; color: #111827; }
        .box p { margin: 2px 0; font-size: 11px; color: #374151; line-height: 1.35; }
        .box p strong { color: #111827; }

        table { width: 100%; border-collapse: collapse; }
        thead th { font-size: 10px; text-transform: uppercase; letter-spacing: 0.6px; color: #374151; background: #F9FAFB; border: 1px solid #E5E7EB; padding: 8px 6px; text-align: left; }
        tbody td { font-size: 11px; border: 1px solid #E5E7EB; padding: 8px 6px; vertical-align: top; }
        .num { text-align: right; font-variant-numeric: tabular-nums; }
        .center { text-align: center; }

        .totals { margin-top: 12px; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 12px; }
        .totals-left { border: 1px solid #E5E7EB; border-radius: 10px; padding: 10px 12px; }
        .totals-left h4 { margin: 0 0 6px 0; font-size: 11px; font-weight: 700; color: #111827; }
        .totals-left .words { font-size: 11px; color: #374151; line-height: 1.35; }

        .totals-right { border: 1px solid #E5E7EB; border-radius: 10px; padding: 10px 12px; }
        .totals-right .line { display: flex; justify-content: space-between; gap: 10px; margin: 6px 0; font-size: 11px; color: #111827; }
        .totals-right .line .label { color: #6B7280; }
        .totals-right .line .value { font-weight: 600; font-variant-numeric: tabular-nums; }
        .totals-right .grand { border-top: 1px solid #E5E7EB; padding-top: 8px; margin-top: 8px; }
        .totals-right .grand .label { font-weight: 700; color: #111827; }
        .totals-right .grand .value { font-weight: 800; font-size: 13px; }

        .notes { margin-top: 12px; font-size: 10.5px; color: #374151; line-height: 1.4; }
        .footer { margin-top: 18px; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .sign { border: 1px solid #E5E7EB; border-radius: 10px; padding: 10px 12px; min-height: 84px; }
        .sign .cap { font-size: 11px; font-weight: 700; color: #111827; margin: 0 0 10px 0; }
        .sign .hint { font-size: 10px; color: #6B7280; }

        @page { size: A4; margin: 8mm; }
    </style>
</head>

<body>
    <div class="page">
        <div class="header">
            <div class="header-left">
                <h1 class="title"><%= invoiceTitle %></h1>
                <p class="subtitle"><%= invoiceSubtitle %></p>

                <div class="seller">
                    <p class="name"><%= seller.name %></p>
                    <p class="meta"><%= seller.lines %></p>
                </div>
            </div>

            <div class="header-right">
                <div class="invoice-meta">
                    <div class="row"><span class="label">Invoice No</span><span class="value"><%= bill.bno %></span></div>
                    <div class="row"><span class="label">Invoice Date</span><span class="value"><%= bill.bdate %></span></div>
                    <% if (bill.order_no) { %>
                        <div class="row"><span class="label">PO / Ref</span><span class="value"><%= bill.order_no %></span></div>
                    <% } %>
                    <% if (bill.vehicle_no) { %>
                        <div class="row"><span class="label">Vehicle No</span><span class="value"><%= bill.vehicle_no %></span></div>
                    <% } %>
                    <% if (bill.dispatch_through) { %>
                        <div class="row"><span class="label">Dispatch Through</span><span class="value"><%= bill.dispatch_through %></span></div>
                    <% } %>
                    <div class="row"><span class="label">Place of Supply</span><span class="value"><%= bill.supply || '' %></span></div>
                    <% if (bill.reverseCharge) { %>
                        <div class="row"><span class="label">Reverse Charge</span><span class="value">Yes</span></div>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="divider"></div>

        <div class="two-col">
            <div class="box">
                <h3>
                    <% if (bill.transactionType) { %>
                        <% if (bill.transactionType === 'SALE') { %>
                            Bill To (Buyer)
                        <% } else if (bill.transactionType === 'PURCHASE') { %>
                            Bill From (Supplier)
                        <% } else if (bill.transactionType === 'CREDIT NOTE') { %>
                            Bill To (Recipient)
                        <% } else if (bill.transactionType === 'DEBIT NOTE') { %>
                            Bill From (Supplier)
                        <% } else if (bill.transactionType === 'DELIVERY NOTE') { %>
                            Deliver From (Supplier)
                        <% } else { %>
                            Bill To (Buyer)
                        <% } %>
                    <% } else { %>
                        Bill To (Buyer)
                    <% } %>
                </h3>
                <p><strong><%= buyer.name %></strong></p>
                <% if (buyer.address) { %><p><%= buyer.address %></p><% } %>
                <% if (buyer.state) { %><p>State: <strong><%= buyer.state %></strong></p><% } %>
                <% if (buyer.pin) { %><p>PIN: <strong><%= buyer.pin %></strong></p><% } %>
                <% if (buyer.gstin) { %><p>GSTIN: <strong><%= buyer.gstin %></strong></p><% } %>
            </div>

            <div class="box">
                <h3>
                    <% if (bill.transactionType) { %>
                        <% if (bill.transactionType === 'SALE') { %>
                            Ship To (Consignee)
                        <% } else if (bill.transactionType === 'PURCHASE') { %>
                            Bill To (Receiver)
                        <% } else if (bill.transactionType === 'CREDIT NOTE') { %>
                            Ship To (Consignee)
                        <% } else if (bill.transactionType === 'DEBIT NOTE') { %>
                            Bill To (Recipient)
                        <% } else if (bill.transactionType === 'DELIVERY NOTE') { %>
                            Deliver To (Recipient)
                        <% } else { %>
                            Ship To (Consignee)
                        <% } %>
                    <% } else { %>
                        Ship To (Consignee)
                    <% } %>
                </h3>
                <p><strong><%= consignee.name %></strong></p>
                <% if (consignee.address) { %><p><%= consignee.address %></p><% } %>
                <% if (consignee.state) { %><p>State: <strong><%= consignee.state %></strong></p><% } %>
                <% if (consignee.pin) { %><p>PIN: <strong><%= consignee.pin %></strong></p><% } %>
                <% if (consignee.gstin) { %><p>GSTIN: <strong><%= consignee.gstin %></strong></p><% } %>
            </div>
        </div>

        <div class="divider"></div>

        <table>
            <thead>
                <tr>
                    <th style="width: 34px;" class="center">#</th>
                    <th>Description</th>
                    <th style="width: 72px;">HSN/SAC</th>
                    <th style="width: 58px;" class="center">Qty</th>
                    <th style="width: 68px;" class="center">UOM</th>
                    <th style="width: 74px;" class="num">Rate</th>
                    <th style="width: 62px;" class="num">Disc%</th>
                    <th style="width: 62px;" class="num">GST%</th>
                    <th style="width: 92px;" class="num">Amount</th>
                </tr>
            </thead>
            <tbody>
                <% items.forEach((it, idx) => { %>
                    <tr>
                        <td class="center"><%= idx + 1 %></td>
                        <td>
                            <div style="font-weight: 600;"><%= it.item || '' %></div>
                            <% if (it.batch) { %>
                                <div style="margin-top: 2px; color:#6B7280; font-size:10.5px;">Batch: <%= it.batch %></div>
                            <% } %>
                            <% if (it.item_narration) { %>
                                <div style="margin-top: 2px; color:#6B7280; font-size:10.5px;"><%= it.item_narration %></div>
                            <% } %>
                        </td>
                        <td><%= it.hsn || '' %></td>
                        <td class="center"><%= formatQty(it.qty) %></td>
                        <td class="center"><%= it.uom || '' %></td>
                        <td class="num"><%= formatINR(it.rate) %></td>
                        <td class="num"><%= formatPercent(it.disc) %></td>
                        <td class="num"><%= gstApplicable ? formatPercent(it.grate) : '-' %></td>
                        <td class="num"><%= formatINR(it.total) %></td>
                    </tr>
                <% }); %>

                <% if (otherCharges && otherCharges.length) { %>
                    <% otherCharges.forEach((ch, idx) => { %>
                        <tr>
                            <td class="center"><%= items.length + idx + 1 %></td>
                            <td>
                                <div style="font-weight: 600;"><%= ch.name || ch.type || 'Other Charge' %></div>
                                <div style="margin-top: 2px; color:#6B7280; font-size:10.5px;">HSN/SAC: <%= ch.hsnSac || '' %></div>
                            </td>
                            <td><%= ch.hsnSac || '' %></td>
                            <td class="center">1</td>
                            <td class="center">NOS</td>
                            <td class="num"><%= formatINR(ch.amount) %></td>
                            <td class="num">0</td>
                            <td class="num"><%= gstApplicable ? formatPercent(ch.gstRate) : '-' %></td>
                            <td class="num"><%= formatINR(ch.amount) %></td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>

        <% if (hsnSummary && hsnSummary.length && gstApplicable) { %>
            <div class="divider"></div>
            <div class="box" style="padding: 0; overflow: hidden;">
                <div style="padding: 10px 12px;">
                    <h3 style="margin: 0;">HSN/SAC Summary</h3>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th style="width: 90px;">HSN/SAC</th>
                            <th class="num">Taxable Value</th>
                            <th class="num">CGST</th>
                            <th class="num">SGST</th>
                            <th class="num">IGST</th>
                            <th class="num">Total Tax</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% hsnSummary.forEach((row) => { %>
                            <tr>
                                <td><%= row.hsn %></td>
                                <td class="num"><%= formatINR(row.taxable) %></td>
                                <td class="num"><%= gstApplicable && totals.taxMode === 'CGST_SGST' ? formatINR(row.cgst) : formatINR(0) %></td>
                                <td class="num"><%= gstApplicable && totals.taxMode === 'CGST_SGST' ? formatINR(row.sgst) : formatINR(0) %></td>
                                <td class="num"><%= gstApplicable && totals.taxMode === 'IGST' ? formatINR(row.igst) : formatINR(0) %></td>
                                <td class="num"><%= gstApplicable ? formatINR(row.totalTax) : formatINR(0) %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>


        <div class="totals">
            <div class="totals-left">
                <h4>Amount (in words)</h4>
                <div class="words"><%= amountInWords %></div>
                <% if (bill.narration) { %>
                    <div style="margin-top: 10px;">
                        <h4 style="margin-bottom: 6px;">Narration</h4>
                        <div class="words"><%= bill.narration %></div>
                    </div>
                <% } %>
            </div>

            <div class="totals-right">
                <div class="line"><span class="label">Taxable Value</span><span class="value"><%= formatINR(totals.taxableValue) %></span></div>

                <% if (gstApplicable) { %>
                    <% if (totals.taxMode === 'CGST_SGST') { %>
                        <div class="line"><span class="label">CGST</span><span class="value"><%= formatINR(totals.cgst) %></span></div>
                        <div class="line"><span class="label">SGST</span><span class="value"><%= formatINR(totals.sgst) %></span></div>
                    <% } else { %>
                        <div class="line"><span class="label">IGST</span><span class="value"><%= formatINR(totals.igst) %></span></div>
                    <% } %>
                <% } %>

                <div class="line"><span class="label">Total Tax</span><span class="value"><%= gstApplicable ? formatINR(totals.totalTax) : formatINR(0) %></span></div>

                <div class="line"><span class="label">Round Off</span><span class="value"><%= formatINR(totals.roundOff) %></span></div>

                <% if (bill.reverseCharge && gstApplicable) { %>
                    <div class="notes" style="margin-top: 8px;">Reverse charge applicable. Tax liability is on recipient.</div>
                <% } %>

                <div class="line grand">
                    <span class="label">Grand Total</span>
                    <span class="value"><%= formatINR(totals.roundedGrandTotal) %></span>
                </div>
            </div>
        </div>

        <div class="footer">
            <div class="sign">
                <div class="cap">Receiver's Signature</div>
                <div class="hint">(Authorised Signatory)</div>
            </div>
            <div class="sign">
                <div class="cap">For <%= seller.name %></div>
                <div class="hint" style="margin-top: 32px;">(Authorised Signatory)</div>
            </div>
        </div>
    </div>
</body>

</html>
