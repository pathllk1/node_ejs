<% layout('layouts/main') -%>

<div class="container mx-auto px-4 py-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Sales Report</h1>
    <div class="flex space-x-3">
      <input type="date" id="startDate" class="border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
      <input type="date" id="endDate" class="border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
      <button id="filterBtn" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded text-sm font-medium transition-colors">
        Filter
      </button>
      <button id="exportBtn" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded text-sm font-medium transition-colors">
        Export Excel
      </button>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-white p-4 rounded-lg shadow border border-gray-200">
      <div class="text-gray-500 text-sm">Total Sales</div>
      <div id="totalSales" class="text-2xl font-bold text-gray-800">₹0.00</div>
    </div>
    <div class="bg-white p-4 rounded-lg shadow border border-gray-200">
      <div class="text-gray-500 text-sm">Total Invoices</div>
      <div id="totalInvoices" class="text-2xl font-bold text-gray-800">0</div>
    </div>
    <div class="bg-white p-4 rounded-lg shadow border border-gray-200">
      <div class="text-gray-500 text-sm">Avg. Invoice Value</div>
      <div id="avgInvoiceValue" class="text-2xl font-bold text-gray-800">₹0.00</div>
    </div>
    <div class="bg-white p-4 rounded-lg shadow border border-gray-200">
      <div class="text-gray-500 text-sm">Total Items Sold</div>
      <div id="totalItemsSold" class="text-2xl font-bold text-gray-800">0</div>
    </div>
  </div>

  <!-- Sales Report Table -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200" id="salesReportTable">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Bill No</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Party</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ref/PO No</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Taxable</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Tax</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Other Charges</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Total</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">RC</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200" id="salesReportBody">
          <!-- Data will be populated by JavaScript -->
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Firm name will be available through data attributes or API -->

<script src="/javascripts/xlsx.bundle.js"></script>
<script src="/javascripts/inventory/sales-report.js"></script>