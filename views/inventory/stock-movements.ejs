<% layout('layouts/main') -%>

<div class="p-4 w-full mx-auto">
    <div class="flex justify-between items-center mb-4">
        <h1 class="text-2xl font-bold text-gray-800 tracking-tight">Stock Movement Tracking</h1>
        <div class="flex gap-2">
            <button id="addMovementBtn"
                class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-1.5 rounded-lg shadow-sm transition-colors cursor-pointer flex items-center gap-1">
                <span>+</span> Add Manual Movement
            </button>
            <button id="exportMovementsBtn"
                class="bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-4 py-1.5 rounded-lg shadow-sm transition-colors cursor-pointer flex items-center gap-1">
                📥 Export
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="bg-white p-4 rounded-lg shadow-md mb-4 border border-gray-200">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-4">
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Start Date</label>
                <input type="date" id="startDateFilter" 
                    class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none shadow-sm">
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">End Date</label>
                <input type="date" id="endDateFilter" 
                    class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none shadow-sm">
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Stock Item</label>
                <select id="stockFilter" 
                    class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none shadow-sm">
                    <option value="">All Items</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Movement Type</label>
                <select id="typeFilter" 
                    class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none shadow-sm">
                    <option value="">All Types</option>
                    <option value="SALE">Sale</option>
                    <option value="RECEIPT">Receipt</option>
                    <option value="TRANSFER">Transfer</option>
                    <option value="ADJUSTMENT">Adjustment</option>
                    <option value="OPENING">Opening</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Batch</label>
                <input type="text" id="batchFilter" placeholder="Filter by batch..."
                    class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none shadow-sm">
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Search</label>
                <input type="text" id="searchFilter" placeholder="Search items, bills..."
                    class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none shadow-sm">
            </div>
        </div>
        <div class="mt-3 flex justify-end gap-2">
            <button id="applyFiltersBtn" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-1.5 rounded shadow-sm transition-colors">
                Apply Filters
            </button>
            <button id="clearFiltersBtn" class="bg-gray-500 hover:bg-gray-600 text-white text-sm font-medium px-4 py-1.5 rounded shadow-sm transition-colors">
                Clear Filters
            </button>
        </div>
    </div>

    <!-- Movement Table -->
    <div class="overflow-hidden shadow-md rounded-lg border border-gray-200 bg-white">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse whitespace-nowrap">
                <thead>
                    <tr class="bg-gradient-to-r from-green-500 to-yellow-500 text-gray-600 text-xs uppercase font-bold border-b border-gray-300 tracking-wider">
                        <th class="px-4 py-3">ID</th>
                        <th class="px-4 py-3">Type</th>
                        <th class="px-4 py-3">Date</th>
                        <th class="px-4 py-3">Item</th>
                        <th class="px-4 py-3">Batch</th>
                        <th class="px-4 py-3 text-right">Quantity</th>
                        <th class="px-4 py-3 text-center">UOM</th>
                        <th class="px-4 py-3 text-right">Rate</th>
                        <th class="px-4 py-3 text-right">Total</th>
                        <th class="px-4 py-3">Reference</th>
                        <th class="px-4 py-3">User</th>
                        <th class="px-4 py-3">Created At</th>
                    </tr>
                </thead>
                <tbody id="movementsTableBody" class="text-xs text-gray-700 divide-y divide-gray-100"></tbody>
            </table>
        </div>
    </div>

    <div class="flex justify-between items-center mt-4 text-xs font-medium text-gray-600">
        <span id="movementsPageInfo" class="bg-gray-100 px-3 py-1 rounded-full">Loading...</span>
        <div class="flex gap-2">
            <button id="prevMovementsBtn" class="px-3 py-1.5 border border-gray-300 rounded hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed bg-white transition">Previous</button>
            <button id="nextMovementsBtn" class="px-3 py-1.5 border border-gray-300 rounded hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed bg-white transition">Next</button>
        </div>
    </div>
</div>

<!-- Add/Edit Movement Modal -->
<div id="movementModal" class="fixed inset-0 bg-gray-900/60 hidden items-center justify-center z-50 backdrop-blur-sm transition-opacity">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-2xl transform transition-all scale-100 overflow-hidden">
        
        <div class="bg-gradient-to-r from-indigo-600 to-blue-600 px-6 py-4 flex justify-between items-center">
            <h2 id="movementModalTitle" class="text-lg font-bold text-white tracking-wide">Add New Stock Movement</h2>
            <button id="closeMovementModalBtn" class="text-white/80 hover:text-white text-2xl font-light leading-none">&times;</button>
        </div>
        
        <form id="movementForm" class="p-6">
            <input type="hidden" id="movementId">
            
            <div class="grid grid-cols-12 gap-4 text-sm">
                <div class="col-span-6">
                    <label class="block text-gray-700 font-semibold mb-1">Movement Type <span class="text-red-500">*</span></label>
                    <select name="type" required id="movementType" 
                        class="w-full border border-gray-300 rounded px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition">
                        <option value="">Select Type</option>
                        <option value="RECEIPT">Receipt</option>
                        <option value="TRANSFER">Transfer</option>
                        <option value="ADJUSTMENT">Adjustment</option>
                        <option value="OPENING">Opening</option>
                    </select>
                </div>
                
                <div class="col-span-6">
                    <label class="block text-gray-700 font-semibold mb-1">Stock Item <span class="text-red-500">*</span></label>
                    <select name="stockId" required id="movementStockId"
                        class="w-full border border-gray-300 rounded px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition">
                        <option value="">Loading...</option>
                    </select>
                </div>

                <div class="col-span-4">
                    <label class="block text-gray-600 font-medium mb-1">Batch No</label>
                    <input type="text" name="batch" class="w-full border border-gray-300 rounded px-3 py-2 focus:ring-1 focus:ring-indigo-500 outline-none">
                </div>
                
                <div class="col-span-4">
                    <label class="block text-gray-700 font-bold mb-1">Quantity <span class="text-red-500">*</span></label>
                    <input type="number" step="0.01" name="qty" required class="w-full border border-gray-300 bg-yellow-50 rounded px-3 py-2 focus:ring-2 focus:ring-yellow-400 outline-none font-medium">
                </div>
                
                <div class="col-span-4">
                    <label class="block text-gray-700 font-bold mb-1">UOM <span class="text-red-500">*</span></label>
                    <select name="uom" required class="w-full border border-gray-300 rounded px-3 py-2 bg-white focus:ring-1 focus:ring-indigo-500 outline-none">
                        <option value="PCS">PCS</option>
                        <option value="KG">KG</option>
                        <option value="LTR">LTR</option>
                        <option value="MTR">MTR</option>
                        <option value="BOX">BOX</option>
                        <option value="NOS">NOS</option>
                        <option value="SET">SET</option>
                        <option value="ROL">ROL</option>
                        <option value="UNIT">UNIT</option>
                        <option value="OTH">OTH</option>
                    </select>
                </div>

                <div class="col-span-6">
                    <label class="block text-gray-600 font-medium mb-1">Rate</label>
                    <input type="number" step="0.01" name="rate" class="w-full border border-gray-300 rounded px-3 py-2 focus:ring-1 focus:ring-indigo-500 outline-none">
                </div>
                
                <div class="col-span-6">
                    <label class="block text-gray-600 font-medium mb-1">Total</label>
                    <input type="number" step="0.01" name="total" class="w-full border border-gray-300 rounded px-3 py-2 focus:ring-1 focus:ring-indigo-500 outline-none">
                </div>

                <div class="col-span-12">
                    <label class="block text-gray-600 font-medium mb-1">Description/Narration</label>
                    <textarea name="description" rows="2" 
                        class="w-full border border-gray-300 rounded px-3 py-2 focus:ring-1 focus:ring-indigo-500 outline-none"></textarea>
                </div>

                <div class="col-span-12">
                    <label class="block text-gray-600 font-medium mb-1">Reference Number</label>
                    <input type="text" name="referenceNumber" 
                        class="w-full border border-gray-300 rounded px-3 py-2 focus:ring-1 focus:ring-indigo-500 outline-none">
                </div>
            </div>

            <div class="mt-8 pt-4 border-t border-gray-100 flex justify-between items-center bg-gray-50 -mx-6 -mb-6 px-6 py-4">
                <div class="text-xs text-gray-500">
                    <span class="block">Track all stock movements across your firm</span>
                </div>
                <div class="flex gap-3">
                    <button type="button" id="cancelMovementModalBtn" class="px-5 py-2 text-sm font-medium text-gray-600 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 shadow-sm transition">Cancel</button>
                    <button type="submit" class="px-5 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 shadow-md shadow-indigo-200 transition">Save Movement</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script src="/javascripts/xlsx.js"></script>
<script src="/javascripts/inventory/stock-movements.js"></script>