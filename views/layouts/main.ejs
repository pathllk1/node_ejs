<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My App</title>
    <!-- Google Fonts Icons (Material Icons) -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <!-- Google Fonts for Typography -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Custom Stylesheet -->
    <link href="/stylesheets/style.css" rel="stylesheet">
     <link href="/stylesheets/layout_style.css" rel="stylesheet">
    <script src="/javascripts/api.js"></script>
</head>

<body class="bg-gray-50 min-h-screen flex flex-col">
    <div class="sky-container">
        
        <div class="bird-container bird-container-one">
            <div class="bird bird-one"></div>
        </div>
        
        <div class="bird-container bird-container-two">
            <div class="bird bird-two"></div>
        </div>
        
        <div class="bird-container bird-container-three">
            <div class="bird bird-three"></div>
        </div>

        <div class="bird-container bird-container-four">
            <div class="bird bird-four"></div>
        </div>

        <div class="plane plane-path-1">
            <span class="material-icons plane-icon-right">flight</span>
        </div>

        <div class="plane plane-path-2">
            <span class="material-icons plane-icon-left">flight</span>
        </div>

        <div class="lightning-flash"></div>
    </div>

    <%- include('../components/navbar') %>

        <main class="flex-grow pt-16 pb-10">
            <%- body -%>
        </main>

        <%- include('../components/footer') %>
            <%- include('../components/toast') %>
                <script src="/javascripts/navbar.js"></script>
                <script src="/javascripts/auth.js"></script>
</body>

</html>