<% layout('layouts/main') %>

<link rel="stylesheet" href="/stylesheets/ledger.css">

<div class="container mx-auto px-4 py-8">
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-800">General Ledger</h1>
        <p class="text-gray-600 mt-2">Comprehensive view of all account transactions</p>
    </div>

    <!-- Tab Navigation -->
    <div class="mb-4 border-b border-gray-200">
        <nav class="flex space-x-2" aria-label="Tabs">
            <button id="tab1" class="active-tab px-4 py-2 text-sm font-medium text-blue-600 border-b-2 border-blue-600 bg-blue-50 rounded-t-lg" data-tab="tab-content-1">
                Account Details
            </button>
            <button id="tab2" class="inactive-tab px-4 py-2 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 rounded-t-lg" data-tab="tab-content-2">
                Account Type Summary
            </button>
        </nav>
    </div>

    <!-- Tab Content -->
    <div id="tab-content-1" class="tab-content active">
        <!-- Data Table with Gradient Header -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
            <!-- Compact Toolbar -->
            <div class="bg-gray-50 px-4 py-2 flex flex-col sm:flex-row items-center justify-between border-b border-gray-200 gap-2">
                <div class="flex flex-1 items-center gap-2">
                    <div class="flex items-center gap-2">
                        <label class="text-xs font-medium text-gray-700 hidden sm:block">Search:</label>
                        <div class="relative">
                            <input 
                                type="text" 
                                id="searchInput" 
                                placeholder="Search accounts..." 
                                class="text-sm pl-8 pr-2 py-1.5 w-40 sm:w-48 border border-gray-300 rounded focus:ring-1 focus:ring-blue-500 focus:border-blue-500 outline-none transition"
                            >
                            <svg class="w-4 h-4 text-gray-400 absolute left-2.5 top-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-2">
                        <label class="text-xs font-medium text-gray-700 hidden sm:block">Type:</label>
                        <select id="accountTypeFilter" class="text-sm py-1.5 px-2 border border-gray-300 rounded focus:ring-1 focus:ring-blue-500 focus:border-blue-500 outline-none transition w-32">
                            <option value="">All</option>
                            <option value="ASSET">Asset</option>
                            <option value="LIABILITY">Liability</option>
                            <option value="EQUITY">Equity</option>
                            <option value="INCOME">Income</option>
                            <option value="EXPENSE">Expense</option>
                            <option value="DEBTOR">Debtor</option>
                            <option value="CREDITOR">Creditor</option>
                            <option value="TAX">Tax</option>
                        </select>
                    </div>
                </div>
                
                <div class="flex items-center gap-2">
                    <div class="text-xs text-gray-700 hidden sm:block">
                        <span id="paginationInfoDesktop">Showing <span id="currentPageStartDesktop">0</span> of <span id="totalRecordsDesktop">0</span></span>
                    </div>
                    <div class="text-xs text-gray-700 sm:hidden">
                        <span id="paginationInfo">Show <span id="currentPageStart">0</span> of <span id="totalRecords">0</span></span>
                    </div>
                    <nav id="paginationControls" class="relative z-0 inline-flex rounded shadow-sm -space-x-px" aria-label="Pagination">
                        <a href="#" id="prevPage" class="pagination-btn relative inline-flex items-center px-2 py-1 text-xs font-medium text-gray-500 hover:bg-gray-100 border border-gray-300 rounded-l">
                            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                        </a>
                        <span id="pageNumbers" class="flex"></span>
                        <a href="#" id="nextPage" class="pagination-btn relative inline-flex items-center px-2 py-1 text-xs font-medium text-gray-500 hover:bg-gray-100 border border-gray-300 rounded-r">
                            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    </nav>
                </div>
            </div>
            
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gradient-to-r from-blue-600 to-purple-600 text-white">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider">Account Head</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider">Account Type</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider">Debit Total</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider">Credit Total</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider">Balance</th>
                            <th class="px-4 py-3 text-center text-xs font-semibold uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="accountTableBody" class="bg-white divide-y divide-gray-200">
                        <tr>
                            <td colspan="6" class="px-4 py-8 text-center text-gray-500">
                                <div class="flex flex-col items-center">
                                    <svg class="w-12 h-12 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                    <p>Loading account balances...</p>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="tab-content-2" class="tab-content hidden">
        <!-- Account Type Summary Table -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gradient-to-r from-blue-600 to-purple-600 text-white">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider">Account Type</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider">No. of Accounts</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider">Total Debit</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider">Total Credit</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider">Net Balance</th>
                            <th class="px-4 py-3 text-center text-xs font-semibold uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="accountTypeSummaryBody" class="bg-white divide-y divide-gray-200">
                        <tr>
                            <td colspan="6" class="px-4 py-8 text-center text-gray-500">
                                <div class="flex flex-col items-center">
                                    <svg class="w-12 h-12 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                    <p>Loading account type summaries...</p>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div id="ledgerModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-xl max-w-6xl w-full max-h-[90vh] overflow-hidden">
        <div class="flex items-center justify-between p-4 border-b border-gray-200">
            <h2 id="modalTitle" class="text-xl font-bold text-gray-800">Account Details</h2>
            <button id="closeModal" class="text-gray-400 hover:text-gray-600 text-2xl font-bold">&times;</button>
        </div>
        <div id="modalBody" class="p-4 overflow-auto max-h-[calc(90vh-100px)]">
            <!-- Loaded via JS -->
        </div>
    </div>
</div>

<script src="/javascripts/ledger/ledger.js"></script>
