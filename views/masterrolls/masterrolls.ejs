<% layout('layouts/main') -%>
<div class="p-4 w-full mx-auto">
    <div class="flex justify-between items-center mb-4">
        <h1 class="text-2xl font-bold text-gray-800 tracking-tight">Employee Management</h1>
    </div>

    <!-- Compact Toolbar with no gap to table -->
    <div class="bg-white border border-gray-200 rounded-t-lg shadow-sm p-3 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2">
            <div class="relative">
                <input type="text" id="searchInput" placeholder="Search employees..."
                    class="border border-gray-300 rounded-lg pl-3 pr-8 py-1.5 text-sm w-48 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none shadow-sm transition-all">
                <span class="absolute right-2.5 top-1.5 text-gray-400">🔍</span>
            </div>
            
            <button id="addEmployeeBtn"
                class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium px-3 py-1.5 rounded-lg shadow-sm transition-colors cursor-pointer flex items-center gap-1">
                <span class="text-sm">+</span> <span class="hidden sm:inline">Add Employee</span>
            </button>
            
            <button id="exportBtn"
                class="bg-green-600 hover:bg-green-700 text-white text-xs font-medium px-3 py-1.5 rounded-lg shadow-sm transition-colors cursor-pointer flex items-center gap-1">
                <span class="text-sm">📥</span> <span class="hidden sm:inline">Export</span>
            </button>
        </div>
        
        <div class="flex items-center gap-3">
            <div class="flex items-center gap-1">
                <label for="itemsPerPage" class="text-gray-700 text-xs">Show:</label>
                <select id="itemsPerPage" class="border border-gray-300 rounded px-2 py-1 text-xs">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="all">All</option>
                </select>
            </div>
            
            <div class="flex items-center gap-2">
                <span id="pageInfo" class="text-xs text-gray-600 min-w-[120px]">Loading...</span>
                <button id="prevBtn" class="px-2.5 py-1.5 border border-gray-300 rounded hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed bg-white transition text-xs">Prev</button>
                <button id="nextBtn" class="px-2.5 py-1.5 border border-gray-300 rounded hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed bg-white transition text-xs">Next</button>
            </div>
        </div>
    </div>

    <!-- Table with no gap to toolbar -->
    <div class="overflow-hidden shadow-md rounded-b-lg border border-t-0 border-gray-200 bg-white">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse whitespace-nowrap">
                <thead>
                    <tr class="bg-gradient-to-r from-slate-700 to-slate-800 text-white text-xs uppercase font-semibold border-b border-gray-300 tracking-wider">
                        <th class="px-3 py-2.5 w-10">ID</th>
                        <th class="px-3 py-2.5">Employee Name</th>
                        <th class="px-3 py-2.5">Aadhar</th>
                        <th class="px-3 py-2.5">Phone</th>
                        <th class="px-3 py-2.5">Category</th>
                        <th class="px-3 py-2.5">Status</th>
                        <th class="px-3 py-2.5">Join Date</th>
                        <th class="px-3 py-2.5 text-center">Action</th>
                    </tr>
                </thead>
                <tbody id="employeeTableBody" class="text-xs text-gray-700 divide-y divide-gray-100"></tbody>
            </table>
        </div>
    </div>
</div>

<div id="employeeModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 backdrop-blur-sm transition-opacity p-3 sm:p-6">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-3xl transform transition-all scale-100 overflow-hidden">
        
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-4 sm:px-6 py-3 flex items-center justify-between">
            <div class="min-w-0">
                <h2 id="modalTitle" class="text-sm sm:text-base font-semibold text-white tracking-wide truncate">Employee Details</h2>
                <div class="text-[11px] text-white/80 leading-4">Review personal, employment, and bank details</div>
            </div>
            <button id="closeModalBtn" class="ml-3 shrink-0 h-9 w-9 inline-flex items-center justify-center rounded-md text-white/90 hover:text-white hover:bg-white/10 transition" aria-label="Close">&times;</button>
        </div>
        
        <div id="employeeDetails" class="p-4 sm:p-6 overflow-y-auto max-h-[70vh]">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div class="rounded-lg border border-gray-100 bg-white">
                    <div class="px-4 py-3 border-b border-gray-100">
                        <div class="text-[11px] font-semibold text-gray-700 uppercase tracking-wide">Personal</div>
                    </div>
                    <div class="p-4">
                        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-xs">
                            <div>
                                <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">Employee Name</dt>
                                <dd id="detailEmployeeName" class="mt-1 text-gray-900 font-semibold"></dd>
                            </div>
                            <div>
                                <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">Father/Husband</dt>
                                <dd id="detailFatherHusbandName" class="mt-1 text-gray-800"></dd>
                            </div>
                            <div>
                                <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">Aadhar</dt>
                                <dd id="detailAadhar" class="mt-1 text-gray-800 font-mono"></dd>
                            </div>
                            <div>
                                <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">Phone</dt>
                                <dd id="detailPhone" class="mt-1 text-gray-800"></dd>
                            </div>
                            <div>
                                <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">Date of Birth</dt>
                                <dd id="detailDateOfBirth" class="mt-1 text-gray-800"></dd>
                            </div>
                            <div>
                                <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">Address</dt>
                                <dd id="detailAddress" class="mt-1 text-gray-800 whitespace-pre-line"></dd>
                            </div>
                        </dl>
                    </div>
                </div>

                <div class="rounded-lg border border-gray-100 bg-white">
                    <div class="px-4 py-3 border-b border-gray-100">
                        <div class="text-[11px] font-semibold text-gray-700 uppercase tracking-wide">Employment</div>
                    </div>
                    <div class="p-4">
                        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-xs">
                            <div>
                                <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">Category</dt>
                                <dd id="detailCategory" class="mt-1 text-gray-800"></dd>
                            </div>
                            <div>
                                <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">Status</dt>
                                <dd id="detailStatus" class="mt-1 text-gray-800"></dd>
                            </div>
                            <div>
                                <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">Date of Joining</dt>
                                <dd id="detailDateOfJoining" class="mt-1 text-gray-800"></dd>
                            </div>
                            <div>
                                <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">Date of Exit</dt>
                                <dd id="detailDateOfExit" class="mt-1 text-gray-800"></dd>
                            </div>
                            <div>
                                <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">Daily Wage</dt>
                                <dd id="detailPDayWage" class="mt-1 text-gray-800"></dd>
                            </div>
                            <div>
                                <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">Project</dt>
                                <dd id="detailProject" class="mt-1 text-gray-800"></dd>
                            </div>
                            <div>
                                <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">Site</dt>
                                <dd id="detailSite" class="mt-1 text-gray-800"></dd>
                            </div>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="mt-4 rounded-lg border border-gray-100 bg-white">
                <div class="px-4 py-3 border-b border-gray-100">
                    <div class="text-[11px] font-semibold text-gray-700 uppercase tracking-wide">Bank & Statutory</div>
                </div>
                <div class="p-4">
                    <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-3 text-xs">
                        <div>
                            <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">Bank</dt>
                            <dd id="detailBank" class="mt-1 text-gray-800"></dd>
                        </div>
                        <div>
                            <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">Branch</dt>
                            <dd id="detailBranch" class="mt-1 text-gray-800"></dd>
                        </div>
                        <div class="sm:col-span-2">
                            <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">Account Number</dt>
                            <dd id="detailAccountNo" class="mt-1 text-gray-800 font-mono"></dd>
                        </div>
                        <div>
                            <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">IFSC</dt>
                            <dd id="detailIfsc" class="mt-1 text-gray-800 font-mono"></dd>
                        </div>
                        <div>
                            <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">ESIC</dt>
                            <dd id="detailEsicNo" class="mt-1 text-gray-800"></dd>
                        </div>
                        <div>
                            <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">PAN</dt>
                            <dd id="detailPan" class="mt-1 text-gray-800"></dd>
                        </div>
                        <div>
                            <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">SKalyan</dt>
                            <dd id="detailSKalyanNo" class="mt-1 text-gray-800"></dd>
                        </div>
                        <div>
                            <dt class="text-[10px] font-semibold uppercase tracking-wide text-gray-500">UAN</dt>
                            <dd id="detailUan" class="mt-1 text-gray-800"></dd>
                        </div>
                    </dl>
                </div>
            </div>
        </div>
        
        <div class="border-t border-gray-100 bg-white px-4 sm:px-6 py-3">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                <button id="closeModalBtn2" class="inline-flex justify-center items-center px-4 py-2 text-xs font-medium text-gray-700 bg-gray-100 rounded-md hover:bg-gray-200 transition">Close</button>
                <div class="flex flex-col sm:flex-row gap-2 sm:justify-end">
                    <button id="deleteEmployeeBtn" class="inline-flex justify-center items-center px-4 py-2 text-xs font-medium text-red-700 bg-red-50 border border-red-200 rounded-md hover:bg-red-100 transition">Delete</button>
                    <button id="editEmployeeBtn" class="inline-flex justify-center items-center px-4 py-2 text-xs font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 transition shadow-sm">Edit</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Employee Form Modal (Create/Edit) -->
<div id="employeeFormModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-[60] backdrop-blur-sm transition-opacity">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-3xl transform transition-all scale-100 overflow-hidden">
        
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-5 py-3 flex justify-between items-center">
            <h2 id="formModalTitle" class="text-base font-semibold text-white tracking-wide">Add New Employee</h2>
            <button id="closeFormModalBtn" class="text-white/80 hover:text-white text-xl font-light leading-none">&times;</button>
        </div>
        
        <form id="employeeForm" class="p-4">
            <input type="hidden" name="id" id="formEmployeeId">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs max-h-[70vh] overflow-y-auto pr-1">
                
                <!-- Personal Info -->
                <div class="space-y-2">
                    <h3 class="font-semibold text-blue-600 text-[11px] border-b pb-1">Personal Info</h3>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">Employee Name *</label>
                        <input type="text" name="employeeName" required class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                    </div>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">Father/Husband Name</label>
                        <input type="text" name="fatherHusbandName" class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                    </div>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">Aadhar Number *</label>
                        <input type="text" name="aadhar" required class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                    </div>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">Phone Number *</label>
                        <input type="text" name="phoneNo" required class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                    </div>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">Date of Birth</label>
                        <input type="date" name="dateOfBirth" class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                    </div>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">Address</label>
                        <textarea name="address" rows="2" class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs"></textarea>
                    </div>
                </div>

                <!-- Employment Details -->
                <div class="space-y-2">
                    <h3 class="font-semibold text-blue-600 text-[11px] border-b pb-1">Employment</h3>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">Category *</label>
                        <select name="category" required class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                            <option value="">Select Category</option>
                            <option value="Skilled">Skilled</option>
                            <option value="Unskilled">Unskilled</option>
                            <option value="Semi-Skilled">Semi-Skilled</option>
                            <option value="Staff">Staff</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">Status *</label>
                        <select name="status" required class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                            <option value="exited">Exited</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">Date of Joining</label>
                        <input type="date" name="dateOfJoining" class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                    </div>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">Date of Exit</label>
                        <input type="date" name="dateOfExit" class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                    </div>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">Daily Wage (₹)</label>
                        <input type="number" name="pDayWage" class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                    </div>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">Project</label>
                        <input type="text" name="project" class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                    </div>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">Site</label>
                        <input type="text" name="site" class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                    </div>
                </div>

                <!-- Statutory & Bank -->
                <div class="space-y-2">
                    <h3 class="font-semibold text-blue-600 text-[11px] border-b pb-1">Statutory & Bank</h3>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">Bank Name</label>
                        <input type="text" name="bank" class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                    </div>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">Branch</label>
                        <input type="text" name="branch" class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                    </div>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">Account Number</label>
                        <input type="text" name="accountNo" class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                    </div>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">IFSC Code</label>
                        <input type="text" name="ifsc" class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                    </div>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">PAN Number</label>
                        <input type="text" name="pan" class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                    </div>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">UAN</label>
                        <input type="text" name="uan" class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                    </div>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">ESIC Number</label>
                        <input type="text" name="esicNo" class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                    </div>
                    <div>
                        <label class="block text-gray-600 text-[10px] font-semibold mb-0.5">SKalyan Number</label>
                        <input type="text" name="sKalyanNo" class="w-full border border-gray-300 rounded-sm px-2 py-1 focus:ring-1 focus:ring-blue-500 outline-none text-xs">
                    </div>
                </div>
            </div>

            <div class="mt-3 pt-2 border-t border-gray-100 flex justify-end items-center">
                <button type="button" id="cancelFormBtn" class="px-3 py-1.5 text-xs font-medium text-gray-700 bg-gray-200 rounded-sm hover:bg-gray-300 transition shadow-sm mr-1.5">Cancel</button>
                <button type="submit" class="px-3 py-1.5 text-xs font-medium text-white bg-blue-600 rounded-sm hover:bg-blue-700 shadow-sm transition">Save</button>
            </div>
        </form>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteConfirmModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-[70] backdrop-blur-sm transition-opacity">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-sm transform transition-all scale-100 p-4 text-center">
        <div class="w-12 h-12 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-2">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        </div>
        <h3 class="text-base font-semibold text-gray-800 mb-1">Delete Employee?</h3>
        <p class="text-xs text-gray-600 mb-3">Are you sure you want to delete <span id="deleteEmployeeName" class="font-semibold"></span>? This action cannot be undone.</p>
        <div class="flex justify-center gap-2">
            <button id="cancelDeleteBtn" class="px-3 py-1.5 text-xs font-medium text-gray-700 bg-gray-200 rounded-sm hover:bg-gray-300 transition">Cancel</button>
            <button id="confirmDeleteBtn" class="px-3 py-1.5 text-xs font-medium text-white bg-red-600 rounded-sm hover:bg-red-700 transition">Delete</button>
        </div>
    </div>
</div>

<script src="/javascripts/xlsx.js"></script>
<script src="/javascripts/masterrolls/masterrolls.js"></script>